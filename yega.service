[Unit]
Description=YEGA Delivery Platform
After=network.target mongod.service
Wants=network.target

[Service]
Type=forking
User=ec2-user
WorkingDirectory=/home/ec2-user/yega-app
Environment=PATH=/usr/bin:/usr/local/bin:/home/ec2-user/.nvm/versions/node/v18.17.0/bin
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/pm2 start ecosystem.config.js
ExecReload=/usr/local/bin/pm2 restart all
ExecStop=/usr/local/bin/pm2 stop all
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target